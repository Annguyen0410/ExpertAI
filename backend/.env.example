# ExpertAI API configuration. Copy to backend/.env for direct local runs.
# Never commit the populated file.

APP_ENV=development
DATABASE_URL=sqlite:///./expertai.db

# Generate a unique value for production. Development creates an ephemeral key
# when this is blank, invalidating local sessions at restart.
SECRET_KEY=
JWT_ISSUER=expertai-api
JWT_AUDIENCE=expertai-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=expertai_refresh
CSRF_COOKIE_NAME=expertai_csrf
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# Temporary compatibility switches for a local SPA. Set both false in production.
RETURN_REFRESH_TOKEN_IN_BODY=true
ALLOW_LEGACY_REFRESH_BODY=true

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ENABLE_DOCS=true
TRUST_PROXY_HEADERS=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Leave blank to run transparent local safety guidance rather than claiming
# live AI. Add a real key only in your uncommitted environment/secret manager.
GEMINI_API_KEY=

# Documents use a secure local directory for development. Production requires
# DOCUMENT_STORAGE_MODE=gcs and a least-privilege bucket identity.
DOCUMENT_STORAGE_MODE=local
DOCUMENT_STORAGE_DIR=
MAX_DOCUMENT_BYTES=10485760
GCS_BUCKET_NAME=

# Stripe remains unavailable until all values below are genuine configuration.
APP_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
B2C_PRICE_ID=
B2B_PRICE_ID=
B2C_PRICE=1900
B2B_PRICE=9900

# Optional code for controlled professional onboarding. Leave blank to prevent
# professional self-registration; never use this as a long-lived secret.
PROFESSIONAL_INVITE_CODE=
