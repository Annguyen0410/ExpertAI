# Root configuration used by docker compose. Copy to .env and keep it private.

APP_ENV=development
DATABASE_URL=sqlite:////app/data/expertai.db
SECRET_KEY=
JWT_ISSUER=expertai-api
JWT_AUDIENCE=expertai-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
RETURN_REFRESH_TOKEN_IN_BODY=true
ALLOW_LEGACY_REFRESH_BODY=true
CSRF_COOKIE_NAME=expertai_csrf
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ENABLE_DOCS=true
TRUST_PROXY_HEADERS=false

# Live Gemini is optional. Leave blank to make the UI explicitly show local
# safety guidance instead of claiming live AI execution.
GEMINI_API_KEY= 

DOCUMENT_STORAGE_MODE=local
MAX_DOCUMENT_BYTES=10485760
GCS_BUCKET_NAME=

APP_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY= 
B2C_PRICE_ID=
B2B_PRICE_ID=
B2C_PRICE=1900
B2B_PRICE=9900
PROFESSIONAL_INVITE_CODE=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
